{
  "name": "@unpunnyfuns/d3-blockmap",
  "version": "0.3.0",
  "description": "Canvas block map for millions of download blocks, D3 scales and colours",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./brush": {
      "types": "./dist/brush/index.d.ts",
      "import": "./dist/brush/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "demo": "sirv . --dev --port 4173",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-brush": "^3.0.1",
    "d3-color": "^3.1.1",
    "d3-interpolate": "^3.0.2",
    "d3-selection": "^3.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sirv-cli": "^3.0.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "d3",
    "canvas",
    "progress",
    "block-map",
    "bittorrent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unpunnyfuns/d3-blockmap.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/unpunnyfuns/d3-blockmap#readme",
  "bugs": {
    "url": "https://github.com/unpunnyfuns/d3-blockmap/issues"
  }
}
