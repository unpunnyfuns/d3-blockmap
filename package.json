{
  "name": "d3-blockmap",
  "version": "0.1.0",
  "description": "Canvas piece map for millions of download blocks, D3 scales and colours",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "demo": "python3 -m http.server 4173"
  },
  "dependencies": {
    "d3-color": "^3.1.1",
    "d3-interpolate": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "d3",
    "canvas",
    "progress",
    "piece-map",
    "bittorrent"
  ]
}
